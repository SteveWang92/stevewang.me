---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  current?: "projects" | "career";
}

const { title, description, current } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL("/assets/og-default.png", Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Steve Wang",
  url: Astro.site?.toString(),
  email: "mailto:contact@stevewang.me",
  jobTitle: "Full-Stack Developer",
  knowsAbout: [
    "Full-stack development",
    "Data and process automation",
    "Procurement systems",
    "Supply chain workflows",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Steve Wang" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#17201d" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Steve Wang" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <Header current={current} />
    <slot />
    <Footer />
  </body>
</html>
