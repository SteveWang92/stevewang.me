# -----------------------------------------------------------------------------
# Allowlist-style ignore: everything at the repository root is ignored by default and
# only reviewed paths are un-ignored below. A new top-level file or directory stays
# invisible to git until it is deliberately added here — fail-closed, so a stray
# credential or private config cannot be committed by accident.
# -----------------------------------------------------------------------------
/*

# --- Tracked directories ---
!/.github/
!/docs/
!/.vscode/
!/public/
!/src/

# --- Tracked root files ---
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.nvmrc
!/amplify.yml
!/astro.config.mjs
!/changedeck.json
!/CHANGELOG.md
!/CLAUDE.md
!/LICENSE
!/package-lock.json
!/package.json
!/README.md
!/SECURITY.md
!/tsconfig.json

# --- Never track, anywhere in the tree ---
# Local-only notes and files: `.local` in the file or folder name.
*.local.*
*.local/

# Astro / Node output.
node_modules/
dist/
.astro/

# Local OS/editor noise.
.DS_Store
Thumbs.db
.claude/
